#compdef findomain

local -a sources
sources=(
    certspotter crtsh sublist3r facebook spyse threatcrowd virustotalapikey anubis
    urlscan securitytrails threatminer c99 bufferover_free bufferover_paid
)

_arguments -s \
    '(-t --target)'{-t+,--target=}'[Target host]:enter domain:_hosts' \
    '(-r --resolved)'{-r,--resolved}'[Show/write only resolved subdomains]' \
    '(-i --ip)'{-i,--ip}'[Show/write the ip address of resolved subdomains]' \
    '*'{-f+,--file=}'[Use a list of subdomains writen in a file as input]:select file:_files' \
    '(-o --output -u --unique-output)'{-o,--output}'[Write to an automatically generated output file (target.txt)]' \
    '(-o --output -u --unique-output)'{-u+,--unique-output=}'[Write all the results for a target or a list of targets to a specified filename]:select file:_files -X "Select output file or enter filename manually"' \
    '(-m --monitoring-flag)'{-m,--monitoring-flag}'[Activate Findomain monitoring mode]' \
    '--postgres-user=[Postgresql username]:type user:_users' \
    '--postgres-password=[Postgresql password]:enter password:()' \
    '--postgres-host=[Postgresql host]:enter host:_hosts' \
    '--postgres-port=[Postgresql port]:select port:_ports -X "Select port for protocol name or enter it manually"' \
    '--postgres-database=[Postgresql database]:enter database:()' \
    '(-q --quiet)'{-q,--quiet}'[Remove informative messages but show fatal errors or subdomains not found message]' \
    '--query-database[Query the findomain database to search subdomains that have already been discovered]' \
    '*--import-subdomains=[Import subdomains from one or multiple files, one per line]:select file:_files' \
    '--enable-dot[Enable DNS over TLS for resolving subdomains IPs]' \
    '--ipv6-only[Perform a IPv6 lookup only]' \
    '--threads=[Number of threads for lightweight tasks (deprecated, use --lightweight-threads)]:enter threads:()' \
    '--lightweight-threads=[Number of threads to use for lightweight tasks such as IP discovery and HTTP checks (default: 50)]:enter threads:()' \
    '--screenshots-threads=[Number of threads to use for taking screenshots (default: 10)]:enter threads:()' \
    '--parallel-ip-ports-scan=[Number of IPs that will be port-scanned at the same time (default: 10)]:enter IPs:()' \
    "--tcp-connect-threads=[Number of threads to use for TCP connections, the equivalent of Nmap's --min-rate (default: 500)]:enter threads:()" \
    '*--resolvers=[Path to a file (or files) containing a list of DNS IP address]:select file:_files' \
    '--aempty[Send alert to webhooks still when no new subdomains have been found]' \
    '(-x --as-resolver)'{-x,--as-resolver}'[Use Findomain as resolver for a list of domains in a file]' \
    '*'{-w+,--wordlist=}'[Wordlist file to use in the bruteforce process, enables bruteforce mode]:select file:_files' \
    '--no-wildcards[Disable wilcard detection when resolving subdomains]' \
    '*--filter=[Filter subdomains containing specifics strings]:enter string:()' \
    '*--exclude=[Exclude subdomains containing specifics strings]:enter string:()' \
    '*--exclude-sources=[Exclude sources from searching subdomains in]:select source:($sources)' \
    '--http-status[Check the HTTP status of subdomains]' \
    '(-c --config)'{-c+,--config=}'[Use a configuration file (toml, json, hjson, ini or yml)]:select file:_files -g "*.(toml|json|hjson|ini|yml|yaml)(-.)"' \
    '--rate-limit=[Set the rate limit in seconds for each target during enumeration]:enter seconds:()' \
    '--pscan[Enable port scanner]' \
    '--iport=[Initial port to scan (default: 0)]:enter port:()' \
    '--lport=[Last port to scan (default: 1000)]:enter port:()' \
    '(-v --verbose)'{-v,--verbose}'[Enable verbose mode (useful to debug problems)]' \
    '--mtimeout[Allow Findomain to insert data in the database when the webhook returns a timeout error]' \
    '--no-monitor[Disable monitoring mode while saving data to database]' \
    '(-s --screenshots)'{-s+,--screenshots=}'[Path to save the screenshots of the HTTP(S) website for subdomains with active ones]:select dir:_files -/' \
    '--sandbox[Enable Chrome/Chromium sandbox (disabled by default)]' \
    '(-j --jobname)'{-j+,--jobname=}'[Use a database identifier for jobs]:enter job name:()' \
    '--query-jobname[Extract all the subdomains from the database where the job name is the specified using --jobname]' \
    '--http-timeout=[Value in seconds for the HTTP Status check of subdomains (default: 5)]:enter seconds:()' \
    '--tcp-connect-timeout=[Value in milliseconds to wait for the TCP connection in the ports scanning function (default: 2000)]:enter milliseconds:()' \
    '--stdin[Read from stdin instead of files or aguments]' \
    '--ua=[Path to file containing user agents strings]:select file:_files' \
    '--randomize[Enable randomization when reading targets from files]' \
    '--no-resolve[Disable pre-screenshotting jobs (http check and ip discover) when used as resolver]' \
    '--external-subdomains[Get external subdomains with amass and subfinder]' \
    '--validate[Validate all the subdomains from the specified file]' \
    '--resolver-timeout=[Timeout in seconds for the resolver (default: 1)]:enter seconds:()' \
    '--http-retries=[Number of retries for the HTTP Status check of subdomains (default: 1)]:enter retries:()' \
    '--double-dns-check[Check subdomains that report an IP again using trustable resolvers (only with custom resolvers)]' \
    '(-n --no-discover)'{-n,--no-discover}'[Prevent findomain from searching subdomains itself]' \
    '--max-http-redirects=[Maximum number of HTTP redirects to follow (default: 0)]:enter redirects:()' \
    '--reset-database[Reset the database, deleting all the data from it]' \
    '(- *)'{-h,--help}'[Print help]' \
    '(- *)'{-V,--version}'[Print version]'
