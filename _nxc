#compdef nxc netexec

# NetExec (nxc) completion
# https://github.com/Pennyw0rth/NetExec

# Persistent cache for module names and module options.  The files live in
# ${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions/nxc and are invalidated when
# the NetExec binary or the user module directory changes.
_nxc_cache_dir() {
	local dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions/nxc
	if [[ ! -d $dir ]]; then
		mkdir -p -m 700 -- "$dir" 2>/dev/null || return 1
	fi
	REPLY=$dir
}

_nxc_cache_file() {
	local dir
	_nxc_cache_dir || return 1
	dir=$REPLY
	REPLY="$dir/$1"
}

_nxc_cache_valid() {
	local file=$1 bin=${commands[nxc]:-${commands[$service]}}
	local modules_dir
	local -a old

	[[ -r $file ]] || return 1
	[[ -n $bin && $bin -nt $file ]] && return 1
	for modules_dir in ${NXC_PATH:-$HOME/.nxc}/modules; do
		[[ -d $modules_dir && $modules_dir -nt $file ]] && return 1
	done
	# Refresh weekly in case modules were changed without touching the binary.
	old=($file(Nmh+168))
	(( $#old )) && return 1
	return 0
}

_nxc_cache_read() {
	local file=$1
	[[ -r $file ]] || return 1
	reply=("${(@f)$(<$file)}")
	(( $#reply > 0 ))
}

_nxc_cache_write() {
	local file=$1 dir tmp
	shift
	dir=${file:h}
	[[ -d $dir ]] || mkdir -p -m 700 -- "$dir" 2>/dev/null || return 1
	tmp="$file.tmp.$$"
	print -rl -- "$@" >| "$tmp" && mv -f -- "$tmp" "$file"
}

# Modules are loaded from the installed NetExec version at completion time so
# the list follows the installed version (including user modules).
_nxc_modules() {
	local protocol=$_nxc_protocol
	local var=_nxc_modules_${protocol//[^[:alnum:]_]/_}
	local -a modules
	local line file=

	if (( ${(P)+var} )); then
		modules=("${(@P)var}")
	else
		_nxc_cache_file "modules-$protocol" && file=$REPLY
		if [[ -n $file ]] && _nxc_cache_valid $file && _nxc_cache_read $file; then
			modules=("${(@)reply}")
		else
			for line in ${(f)"$(_call_program nxc-modules $service $protocol -L 2>/dev/null)"}; do
				if [[ $line =~ '^\[\*\] ([^ ]+) +(.*)$' ]]; then
					modules+=("$match[1]:$match[2]")
				fi
			done
			(( $#modules && $#file )) && _nxc_cache_write $file "${modules[@]}"
		fi
		(( $#modules )) && typeset -ga $var && set -A $var "${modules[@]}"
	fi

	_describe -t modules 'module' modules
}

# Module options can be passed as KEY=VALUE with -o.  Ask NetExec for the
# options supported by the selected module.
_nxc_module_options() {
	local module line
	local -i i
	local -a opts

	for (( i = 1; i < $#words; i++ )); do
		case $words[i] in
			-M|--module)
				module=$words[i+1]
				break
				;;
			--module=*)
				module=${words[i]#--module=}
				break
				;;
		esac
	done
	[[ -n $module ]] || return 1

	local var=_nxc_module_opts_${module//[^[:alnum:]_]/_}
	local file=
	if (( ${(P)+var} )); then
		opts=("${(@P)var}")
	else
		_nxc_cache_file "module-options-${_nxc_protocol}-${module//[^[:alnum:]_]/_}" && file=$REPLY
		if [[ -n $file ]] && _nxc_cache_valid $file && _nxc_cache_read $file; then
			opts=("${(@)reply}")
		else
			for line in ${(f)"$(_call_program nxc-module-options $service ${(q)_nxc_protocol} -M ${(q)module} --options 2>/dev/null)"}; do
				if [[ $line =~ '^([A-Z][A-Z0-9_]*)[[:space:]]{2,}(.*)$' ]]; then
					opts+=("$match[1]=:${${match[2]}//:/\\:}")
				fi
			done
			(( $#opts && $#file )) && _nxc_cache_write $file "${opts[@]}"
		fi
		(( $#opts )) && typeset -ga $var && set -A $var "${opts[@]}"
	fi

	[[ $#opts -gt 0 ]] && _describe -t module-options 'module option' opts
}

_nxc_protocols() {
	local -a protocols
	protocols=(
		'smb:own stuff using SMB'
		'ssh:own stuff using SSH'
		'ldap:own stuff using LDAP'
		'winrm:own stuff using WINRM'
		'mssql:own stuff using MSSQL'
		'rdp:own stuff using RDP'
		'wmi:own stuff using WMI'
		'nfs:own stuff using NFS'
		'ftp:own stuff using FTP'
		'vnc:own stuff using VNC'
	)
	_describe -t protocols 'protocol' protocols
}

_nxc_module_categories() {
	local -a categories
	categories=(
		'enumeration:enumeration modules'
		'credential dumping:credential dumping modules'
		'privilege escalation:privilege escalation modules'
	)
	_describe -t categories 'module category' categories
}

_nxc_targets() {
	_alternative \
		'hosts:host:_hosts' \
		'files:target file:_files'
}

