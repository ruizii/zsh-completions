_nxc() {
	local curcontext="$curcontext" state line protocol
	local -a global_opts opts common_opts
	typeset -A opt_args

	global_opts=(
		'(- *)'{-h,--help}'[Show help message and exit]'
		'(- *)--version[Display nxc version]'
		'(-t --threads)'{-t,--threads}'[set how many concurrent threads to use]:threads:()'
		'--timeout[max timeout in seconds of each thread]:seconds:()'
		'--jitter[sets a random delay between each authentication]:interval:()'
		'--no-progress[do not display progress bar during scan]'
		'--log[export result into a custom file]:log file:_files'
		'(--debug)--verbose[enable verbose output]'
		'(--verbose)--debug[enable debug level information]'
		'-6[Enable force IPv6]'
		'--dns-server[Specify DNS server]:DNS server:_hosts'
		'--dns-tcp[Use TCP instead of UDP for DNS queries]'
		'--dns-timeout[DNS query timeout in seconds]:seconds:()'
	)

	_arguments -C \
		$global_opts \
		'1:protocol:->protocol' \
		'*::arguments:->args'

	case $state in
		protocol)
			_nxc_protocols
			;;
		args)
			protocol=$line[1]
			case $protocol in
				smb) _nxc_smb_opts ;;
				ssh) _nxc_ssh_opts ;;
				ldap) _nxc_ldap_opts ;;
				winrm) _nxc_winrm_opts ;;
				mssql) _nxc_mssql_opts ;;
				rdp) _nxc_rdp_opts ;;
				wmi) _nxc_wmi_opts ;;
				nfs) _nxc_nfs_opts ;;
				ftp) _nxc_ftp_opts ;;
				vnc) _nxc_vnc_opts ;;
				*) return 1 ;;
			esac
			opts=($reply)
			_nxc_common_opts
			common_opts=($reply)
			local _nxc_protocol=$protocol
			_arguments \
				$common_opts \
				$opts \
				'*:target:_nxc_targets'
			;;
	esac
}

_nxc "$@"
